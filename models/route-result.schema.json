{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/sealagom/sealagom-api/main/models/route-result.schema.json",
  "title": "RouteResult",
  "$comment": "Made by models/build_models.py from openapi.yaml (components/schemas/RouteResult); do not edit.",
  "type": "object",
  "required": [
    "source",
    "waypoints",
    "route_nm",
    "departure",
    "speed_kn",
    "corridor_nm",
    "navareas",
    "count",
    "results"
  ],
  "properties": {
    "source": {
      "type": "string",
      "description": "The file name, or json"
    },
    "waypoints": {
      "type": "integer",
      "description": "The number of waypoints read"
    },
    "route_nm": {
      "type": "number"
    },
    "departure": {
      "type": "string",
      "format": "date-time"
    },
    "speed_kn": {
      "type": "number"
    },
    "corridor_nm": {
      "type": "number"
    },
    "navareas": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/RouteNavarea"
      }
    },
    "count": {
      "type": "integer"
    },
    "results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/RouteWarning"
      }
    },
    "meta": {
      "oneOf": [
        {
          "$ref": "#/$defs/TierMeta"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "description": "The answer of POST /api/v2/route/ and the drop link.",
  "$defs": {
    "AnalysisCompact": {
      "type": "object",
      "description": "The short analysis of a warning (route checks and warnings near a position).",
      "properties": {
        "headline": {
          "type": "string"
        },
        "category": {
          "type": "string",
          "description": "One of the AnalysisCategory ids"
        },
        "category_label": {
          "type": "string"
        },
        "subject": {
          "type": "string"
        },
        "subject_label": {
          "type": "string"
        },
        "feeds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FeedRef"
          }
        },
        "severity": {
          "type": "string",
          "description": "critical, high, moderate, low or info (can be empty)"
        },
        "status": {
          "type": "string",
          "description": "The live status: active, scheduled, expired, withdrawn, cancellation_notice or informational"
        },
        "status_label": {
          "type": "string"
        },
        "valid_from": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "valid_until": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "is_routine": {
          "type": "boolean"
        },
        "series_key": {
          "type": "string"
        },
        "series_label": {
          "type": "string"
        },
        "newsworthy": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "FeedRef": {
      "type": "object",
      "properties": {
        "slug": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      }
    },
    "FreeTierMeta": {
      "type": "object",
      "description": "The free tier of this caller (calls left, records a call, the end).",
      "properties": {
        "keyed_on": {
          "type": "string",
          "description": "address or account"
        },
        "calls_left_today": {
          "type": [
            "integer",
            "null"
          ]
        },
        "calls_left_total": {
          "type": [
            "integer",
            "null"
          ]
        },
        "calls_per_day": {
          "type": "integer"
        },
        "records_per_call": {
          "type": "integer"
        },
        "ends_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "plans": {
          "type": "string"
        },
        "trimmed": {
          "type": "boolean",
          "description": "Rows were cut to the records a call"
        },
        "found": {
          "type": "integer",
          "description": "Route checks only: the warnings found before the cut"
        }
      },
      "additionalProperties": true
    },
    "RouteNavarea": {
      "type": "object",
      "properties": {
        "id": {
          "type": [
            "string",
            "null"
          ],
          "description": "The NAVAREA number in Roman numerals"
        },
        "name": {
          "type": "string"
        },
        "coordinator": {
          "type": "string"
        },
        "navarea_id": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Reserved for the region id; null today"
        },
        "warnings_in_force": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Reserved for the count of warnings in force; null today"
        }
      },
      "additionalProperties": true
    },
    "RouteWarning": {
      "type": "object",
      "properties": {
        "scope": {
          "$ref": "#/$defs/WarningScope"
        },
        "region_id": {
          "type": "integer"
        },
        "region_title": {
          "type": "string"
        },
        "id": {
          "type": "integer"
        },
        "number": {
          "type": "string"
        },
        "added_on": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "href": {
          "type": "string",
          "description": "The warning's page, relative to https://www.sealagom.com"
        },
        "ai": {
          "oneOf": [
            {
              "$ref": "#/$defs/AnalysisCompact"
            },
            {
              "type": "null"
            }
          ]
        },
        "along_nm": {
          "type": "number",
          "description": "Distance along the route where it starts"
        },
        "closest_nm": {
          "type": "number",
          "description": "Closest distance from the route"
        },
        "eta_first": {
          "type": "string",
          "format": "date-time"
        },
        "eta_last": {
          "type": "string",
          "format": "date-time"
        },
        "verdict": {
          "type": "string",
          "description": "active_when_you_pass, in_force_no_end_date, not_analysed, outside_activity_periods, starts_after_you_pass, ends_before_you_arrive or informational"
        }
      },
      "additionalProperties": true
    },
    "TierMeta": {
      "type": "object",
      "description": "The meta of an answer that carries only the free tier (meta.free_tier).",
      "properties": {
        "free_tier": {
          "oneOf": [
            {
              "$ref": "#/$defs/FreeTierMeta"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": true
    },
    "WarningScope": {
      "type": "string",
      "description": "navarea or coastal",
      "enum": [
        "navarea",
        "coastal"
      ]
    }
  }
}
