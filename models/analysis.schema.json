{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/sealagom/sealagom-api/main/models/analysis.schema.json",
  "title": "Analysis",
  "$comment": "Made by models/build_models.py from openapi.yaml (components/schemas/Analysis); do not edit.",
  "type": "object",
  "description": "The machine-made analysis of one warning (ai_analysis, Full API). The machine-made analysis of one warning (Full API). The warning is the authority. status, severity and category are open strings: new values can appear.",
  "properties": {
    "headline": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "description": "One of the AnalysisCategory ids"
    },
    "category_label": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "subject_label": {
      "type": "string"
    },
    "feeds": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/FeedRef"
      },
      "description": "The feeds the warning is in (ice included)"
    },
    "severity": {
      "type": "string",
      "description": "critical, high, moderate, low or info (can be empty)"
    },
    "status": {
      "type": "string",
      "description": "The live status: active, scheduled, expired, withdrawn, cancellation_notice or informational"
    },
    "status_label": {
      "type": "string"
    },
    "valid_from": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "valid_until": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "The end of validity (the warning's own cancel date when the analysis has none)"
    },
    "is_routine": {
      "type": "boolean"
    },
    "series_key": {
      "type": "string"
    },
    "series_label": {
      "type": "string"
    },
    "newsworthy": {
      "type": "boolean"
    },
    "summary": {
      "type": "string"
    },
    "status_at_analysis": {
      "type": "string",
      "description": "active, scheduled, expired, cancellation_notice or informational when analysed (can be empty)"
    },
    "validity_text": {
      "type": "string"
    },
    "time_windows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AnalysisTimeWindow"
      }
    },
    "location": {
      "type": "string"
    },
    "hazards": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "mariner_action": {
      "type": "string"
    },
    "background": {
      "type": "string",
      "description": "General knowledge, newsworthy warnings only (not from the warning)"
    },
    "cancels": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "keep_clear_nm": {
      "type": [
        "number",
        "null"
      ]
    },
    "keep_clear_text": {
      "type": "string"
    },
    "contacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AnalysisContact"
      }
    },
    "vessels": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AnalysisVessel"
      }
    },
    "ports": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AnalysisNamed"
      }
    },
    "platforms": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AnalysisNamed"
      }
    },
    "stations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AnalysisNamed"
      }
    },
    "depth_m": {
      "type": [
        "number",
        "null"
      ]
    },
    "observed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "aids": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AnalysisAid"
      }
    },
    "charts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "positions_read": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "coord_check": {
      "$ref": "#/$defs/CoordCheck"
    },
    "translations": {
      "type": "object",
      "description": "Language code (zh, es, ru, pt, el, uk, tr, fr, tl) to the translated texts",
      "additionalProperties": {
        "$ref": "#/$defs/AnalysisTranslation"
      }
    },
    "confidence": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "analyzed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "model": {
      "type": "string"
    },
    "matches": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true,
      "description": "The region calls only: what the site knows about the named vessels, ports, platforms, stations and aids"
    }
  },
  "additionalProperties": true,
  "$defs": {
    "AnalysisAid": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "identifier": {
          "type": "string"
        },
        "characteristic": {
          "type": "string"
        },
        "condition": {
          "type": "string"
        },
        "position": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "AnalysisContact": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "description": "vhf, phone, email, station, website or other"
        },
        "value": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "AnalysisNamed": {
      "type": "object",
      "description": "A port ({name, country}), a platform or a station ({name, kind})",
      "properties": {
        "name": {
          "type": "string"
        },
        "country": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "AnalysisTimeWindow": {
      "type": "object",
      "properties": {
        "start": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "end": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "AnalysisTranslation": {
      "type": "object",
      "properties": {
        "headline": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "mariner_action": {
          "type": "string"
        },
        "background": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "AnalysisVessel": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "call_sign": {
          "type": "string"
        },
        "mmsi": {
          "type": "string"
        },
        "imo": {
          "type": "string"
        },
        "role": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "CoordCheck": {
      "type": "object",
      "description": "The analysis' positions against the parser's; an empty object when the check did not run",
      "properties": {
        "status": {
          "type": "string",
          "description": "ok, mismatch, parser_found_none, no_positions or skipped"
        },
        "reason": {
          "type": "string"
        },
        "ai_count": {
          "type": "integer"
        },
        "parser_count": {
          "type": "integer"
        },
        "ai_only": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "parser_only": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ai_unparsed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "needs_review": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "FeedRef": {
      "type": "object",
      "properties": {
        "slug": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      }
    }
  }
}
