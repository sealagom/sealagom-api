{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.sealagom.com/schemas/analysis.schema.json",
  "title": "Analysis",
  "description": "The analysis of one warning (ai_analysis, Full API). Made by a model shortly after the warning arrives; status and validity are recomputed on every call. It can be wrong: the warning text is the authority.",
  "type": "object",
  "properties": {
    "headline": { "type": "string", "description": "One line: what and where." },
    "summary": { "type": "string" },
    "category": { "type": "string", "description": "Category id, e.g. military, cables, offshore, sar, piracy_or_security, drifting_object, wreck, aids_to_navigation, ice, survey, other." },
    "category_label": { "type": "string" },
    "subject": { "type": "string", "description": "Finer than the category, e.g. mob, fire, light_unlit, buoy_missing, rig, icebergs; empty when only the category fits." },
    "subject_label": { "type": "string" },
    "feeds": { "type": "array", "items": { "type": "object", "properties": { "slug": { "type": "string" }, "title": { "type": "string" } } } },
    "severity": { "type": "string", "enum": ["critical", "high", "moderate", "low", "info"] },
    "status": { "type": "string", "description": "Live status: in_force, upcoming, expired, cancelled, unknown." },
    "status_label": { "type": "string" },
    "status_at_analysis": { "type": "string" },
    "valid_from": { "type": ["string", "null"], "format": "date-time" },
    "valid_until": { "type": ["string", "null"], "format": "date-time" },
    "validity_text": { "type": "string" },
    "time_windows": { "type": "array", "items": { "type": "object", "properties": { "start": { "type": "string" }, "end": { "type": "string" }, "note": { "type": "string" } } } },
    "location": { "type": "string" },
    "hazards": { "type": "array", "items": { "type": "string" } },
    "mariner_action": { "type": "string", "description": "What a ship should do." },
    "newsworthy": { "type": "boolean" },
    "background": { "type": "string", "description": "General-knowledge context, only when newsworthy; not from the warning text." },
    "keep_clear_nm": { "type": ["number", "null"] },
    "contacts": { "type": "array", "items": { "type": "object", "properties": { "type": { "type": "string", "examples": ["vhf", "phone", "email"] }, "value": { "type": "string" }, "note": { "type": "string" } } } },
    "vessels": { "type": "array", "items": { "type": "object" } },
    "depth_m": { "type": ["number", "null"] },
    "observed_at": { "type": ["string", "null"], "format": "date-time" },
    "aids": { "type": "array", "items": { "type": "object" } },
    "charts": { "type": "array", "items": { "type": "string" } },
    "coord_check": { "type": "object", "properties": { "status": { "type": "string" }, "ai_count": { "type": "integer" }, "parser_count": { "type": "integer" }, "ai_only": { "type": "integer" }, "parser_only": { "type": "integer" } } },
    "translations": { "type": "object", "description": "Per language code: {headline, summary, mariner_action, background}.", "additionalProperties": { "type": "object" } },
    "cancels": { "type": "array", "items": { "type": "string" } },
    "references": { "type": "array", "items": { "type": "string" } },
    "is_routine": { "type": "boolean", "description": "Ice report, rig list, in-force list." },
    "series_key": { "type": "string" },
    "series_label": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "analyzed_at": { "type": "string", "format": "date-time" },
    "model": { "type": "string" }
  }
}
